+# Helper: apply a single safe proposal with the workspace.
+def GapPairProposer_propose_safe_then_apply(adapter, ws, proposals)
+  GapBridgeExecutor.apply(
+    workspace: ws,
+    adapter:   adapter,
+    proposals: proposals,
+    tolerance: Tolerance.default
+  )
+end
