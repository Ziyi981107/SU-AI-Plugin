+  pre_world = ws.entities.map { |rec| [rec.geometry_summary['start'], rec.geometry_summary['end']] }
+  good_proposal = [{
+    'proposal_id' => 'p-good',
+    'state'       => GapPairProposer::STATE_READY_TO_REPAIR,
+    'executable'  => true,
+    'endpoint_a_key' => 'a', 'endpoint_b_key' => 'b',
