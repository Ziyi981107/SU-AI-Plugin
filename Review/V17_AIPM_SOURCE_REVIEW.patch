+        d2 = _segment_orientation(p1, p2, q2)
+        d3 = _segment_orientation(q1, q2, p1)
+        d4 = _segment_orientation(q1, q2, p2)
+        return false if d1.abs < eps || d2.abs < eps || d3.abs < eps || d4.abs < eps
